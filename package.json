{
  "name": "cooldown-bar",
  "private": true,
  "version": "0.0.1",
  "description": "A quiet macOS rate limit monitor for Claude Code, Codex, and custom command providers.",
  "author": "Gelton Aureliano",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geltonaureliano/cooldown-bar.git"
  },
  "homepage": "https://github.com/geltonaureliano/cooldown-bar#readme",
  "bugs": {
    "url": "https://github.com/geltonaureliano/cooldown-bar/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:design": "node --test scripts/design.test.mjs",
    "test": "node --test scripts/*.test.mjs && python3 -m unittest discover -s scripts -p \"test_*.py\"",
    "release:check": "node scripts/ci/version.mjs check",
    "release:version": "node scripts/ci/version.mjs set",
    "test:release": "node --test scripts/release.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=24"
  }
}
